---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CodeViewer from '../components/CodeViewer';
import { getDb, Paste, eq } from '../lib/db';
import { highlight, getLanguageFromExtension } from '../lib/shiki';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

// Parse slug to extract id and optional extension (e.g., "abc123.ts" -> id="abc123", ext="ts")
const [id, ext] = slug.split('.');

const db = getDb();
const result = await db.select().from(Paste).where(eq(Paste.id, id));

if (result.length === 0) {
  return new Response('Paste not found', { status: 404 });
}

const paste = result[0];
const language = ext ? getLanguageFromExtension(ext) : paste.language;
const highlightedHtml = await highlight(paste.content, language);
---

<Layout title={`pp - ${id}`}>
  <main class="relative md:min-w-3xl mx-auto border-l border-r border-mauve-200 flex-1 flex flex-col">
    <div
      class="
      absolute w-4 -left-4 top-0 bottom-0 border-x border-mauve-200
      after:z-0 after:content-[''] after:absolute after:top-0 after:bottom-0 after:left-0 after:right-0 after:bg-mauve-200 after:bg-diagonal after:mask-(--background-image-diagonal) after:mask-size-[6px_6px] after:mask-repeat after:opacity-10
      "
    ></div>
    <div
      class="
      absolute w-4 -right-4 top-0 bottom-0 border-x border-mauve-200
      after:z-0 after:content-[''] after:absolute after:top-0 after:bottom-0 after:left-0 after:right-0 after:bg-mauve-200 after:bg-diagonal after:mask-(--background-image-diagonal) after:mask-size-[6px_6px] after:mask-repeat after:opacity-10
      "
    ></div>

    <Header id={id} />

    <div class="relative">
      <CodeViewer client:load html={highlightedHtml} rawContent={paste.content} />
    </div>
  </main>
</Layout>
