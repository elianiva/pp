---
import Layout from '../layouts/Layout.astro';
import PasteForm from '../components/PasteForm';
---

<Layout>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-semibold text-stone-800 mb-2">pp</h1>
      <p class="text-stone-500">minimal pastebin with syntax highlighting</p>
    </div>

    <PasteForm client:load />
  </main>
</Layout>
