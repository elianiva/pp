<header class="bg-white flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between px-4 py-6">
  <div class="min-w-0">
    <div class="flex items-center gap-2 min-w-0">
      <a
        href="/"
        class="text-lg font-bold"
      >
        pp
      </a>

      {id && (
        <>
          <span class="text-mauve-300 text-sm">/</span>
          <span class="font-mono text-sm text-mauve-400 truncate max-w-[60vw] sm:max-w-none">
            {id}
          </span>
        </>
      )}
    </div>
  </div>

  <div class="flex items-center gap-2 self-start sm:self-auto">
    {id && (
    <a
      href={`/${id}/raw`}
      class="text-sm no-underline hover:underline"
    >
      View Raw
    </a>
    )}
  </div>
</header>

