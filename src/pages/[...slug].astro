---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CodeViewer from '../components/CodeViewer';
import { getDb, Paste, eq } from '../lib/db';
import { highlight, renderMarkdown, getLanguageFromExtension, guessLanguage, getExtension } from '../lib/shiki';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

// Parse slug to extract id and optional extension (e.g., "abc123.tsx" -> id="abc123", ext="tsx")
const [id, ext] = slug.split('.');

const db = getDb();
const result = await db.select().from(Paste).where(eq(Paste.id, id));

if (result.length === 0) {
  return new Response('Paste not found', { status: 404 });
}

const paste = result[0];

// If stored language is "auto" and no extension in URL, detect and redirect
if (paste.language === "auto" && !ext) {
  const detected = guessLanguage(paste.content);
  const extension = getExtension(detected);
  if (extension) {
    return Astro.redirect(`/${id}.${extension}`);
  }
}

const language = ext ? getLanguageFromExtension(ext) : paste.language;
const isMarkdown = language === "markdown";
const codeHtml = await highlight(paste.content, isMarkdown ? "markdown" : language);
const renderedHtml = isMarkdown ? await renderMarkdown(paste.content) : null;
---

<Layout title={`pp - ${id}`}>
  <main class="relative w-full max-w-3xl mx-auto border-x border-mauve-200 flex-1 flex flex-col">
    <div
      class="
      absolute w-2 left-0 top-0 bottom-0 border-x border-mauve-200 md:w-4 md:-left-4
      after:z-0 after:content-[''] after:absolute after:top-0 after:bottom-0 after:left-0 after:right-0 after:bg-mauve-200 after:bg-diagonal after:mask-(--background-image-diagonal) after:mask-size-[6px_6px] after:mask-repeat after:opacity-10
      "
    ></div>
    <div
      class="
      absolute w-2 right-0 top-0 bottom-0 border-x border-mauve-200 sm:w-4 sm:-right-4
      after:z-0 after:content-[''] after:absolute after:top-0 after:bottom-0 after:left-0 after:right-0 after:bg-mauve-200 after:bg-diagonal after:mask-(--background-image-diagonal) after:mask-size-[6px_6px] after:mask-repeat after:opacity-10
      "
    ></div>

    <Header id={id} />

    <div class="relative">
      <CodeViewer client:load html={codeHtml} renderedHtml={renderedHtml} rawContent={paste.content} isMarkdown={isMarkdown} rendered={isMarkdown} />
    </div>
  </main>
</Layout>
