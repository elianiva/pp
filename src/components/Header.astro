---
interface Props {
  id?: string;
  language?: string;
}

const { id, language } = Astro.props;
---

<header class="flex items-center justify-between mb-6">
  <div class="flex items-center gap-3">
    <a
      href="/"
      class="text-2xl font-bold text-primary transition-colors no-underline text-display"
    >
      pp
    </a>

    {id && (
      <>
        <span class="text-muted">/</span>
        <span class="text-mono text-sm text-[var(--text-secondary)] bg-[var(--bg-tertiary)] px-2 py-1 border border-[var(--border-primary)]">
          {id}
        </span>
      </>
    )}

    {language && (
      <>
        <span class="text-muted">·</span>
        <span class="label label-accent">
          {language}
        </span>
      </>
    )}
  </div>

  <div class="flex items-center gap-2">
    {id && (
      <a
        href={`/${id}/raw`}
        class="btn-secondary text-sm no-underline"
      >
        Raw
      </a>
    )}
  </div>
</header>
